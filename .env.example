DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=
ALLOWED_HOSTS=api.delicesdorodis.ci
CSRF_TRUSTED_ORIGINS=https://api.delicesdorodis.ci
CORS_ALLOWED_ORIGINS=https://delicesdorodis.ci
# Base PostgreSQL créée dans cPanel (préfixée par l'identifiant cPanel)
DATABASE_URL=postgres://compte_orodis:motdepasse@localhost:5432/compte_orodis
# false si « Forcer HTTPS » de cPanel fait déjà la redirection et que le site boucle
SECURE_SSL_REDIRECT=true
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Les Délices d'Orodis <no-reply@delicesdorodis.ci>
RESTAURANT_NOTIFY_EMAIL=orodistraiteur@gmail.com
ADMIN_URL=gestion-orodis/
SECURE_HSTS_SECONDS=3600
FRONTEND_API_KEY=
PUBLIC_MEDIA_URL=https://api.delicesdorodis.ci/media/
PUBLIC_SITE_URL=https://delicesdorodis.ci
FRONTEND_REVALIDATE_URL=https://delicesdorodis.ci/api/revalidate
REVALIDATE_SECRET=
SENTRY_DSN=
